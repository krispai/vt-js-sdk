{
  "name": "@krisp.ai/krisp-vt-sdk",
  "version": "1.0.3",
  "description": "Krisp Voice Translation SDK — real-time speech-to-speech translation for the browser.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild ./src/index.ts --bundle --format=esm --platform=browser --outfile=dist/index.js && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "krisp",
    "voice-translation",
    "speech",
    "translation",
    "sdk",
    "real-time",
    "webrtc",
    "websocket",
    "audio"
  ],
  "author": "Krisp Technologies, Inc.",
  "license": "SEE LICENSE IN https://krisp.ai/api-terms-of-service/",
  "homepage": "https://github.com/krispai/vt-js-sdk#readme",
  "bugs": {
    "url": "https://github.com/krispai/vt-js-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krispai/vt-js-sdk.git"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {}
}
